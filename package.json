{
  "name": "nektome-freedom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "release": "standard-version",
    "type-check": "tsc --noEmit",
    "watch:chromium": "npx rimraf dist && node scripts/watch.js chromium",
    "watch:firefox": "npx rimraf dist && node scripts/watch.js firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "build:chromium": "npm run type-check && npx rimraf dist && npm run build:pages && npm run build:background && npm run build:content && node scripts/build-manifest.js chromium",
    "build:firefox": "npm run type-check && npx rimraf dist && npm run build:pages && npm run build:background && npm run build:content && node scripts/build-manifest.js firefox",
    "build:pages": "vite build --config vite.config.pages.js",
    "build:background": "vite build --config vite.config.background.js",
    "build:content": "vite build --config vite.config.content.js"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
